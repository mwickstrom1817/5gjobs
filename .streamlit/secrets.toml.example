# Copy this file to .streamlit/secrets.toml on your server and fill in real values.
# DO NOT commit the real secrets.toml to Git.

# Database (Neon Postgres)
DATABASE_URL = "postgresql://user:pass@host.neon.tech/db?sslmode=require"
# NEON_DB_URL = "postgresql://..."  # older alias, only needed if DATABASE_URL is not set

# Encryption key for location credentials (generate a strong random string)
ENCRYPTION_KEY = "your-encryption-key"

# App config
APP_TIMEZONE = "America/Chicago"
APP_URL = "https://your-domain.com"  # or http://your-droplet-ip during testing

# Optional: restrict login to a specific email domain
ALLOWED_EMAIL_DOMAIN = "yourcompany.com"

# Google OAuth (required for login)
GOOGLE_CLIENT_ID = "your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET = "your-google-client-secret"
GOOGLE_REDIRECT_URI = "https://your-domain.com/"

# R2 / S3-compatible object storage (for photos/docs/signatures)
R2_ENDPOINT_URL = "https://..."
R2_ACCESS_KEY_ID = "..."
R2_SECRET_ACCESS_KEY = "..."
R2_BUCKET_NAME = "..."

# Optional: AI features
GEMINI_API_KEY = "..."

# Optional: push notifications (ntfy)
NTFY_SERVER = "https://ntfy.sh"

# Optional: SMTP for emails
SMTP_SERVER = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_EMAIL = "..."
SMTP_PASSWORD = "..."

# Optional: kiosk/TV display token
KIOSK_TOKEN = "..."

# Optional: remote logo URL
LOGO_URL = "..."
